# 배포에는 게임 실행에 필요한 파일만 올린다.
# (인수인계·설계 문서, 목업, 원본 폰트, 생성 스크립트, 테스트는 공개하지 않는다)
/*
!/index.html
!/styles.css
!/vercel.json
!/src
!/locales
!/assets

/assets/*
!/assets/sprites
!/assets/icon
!/assets/fonts

/assets/fonts/*
!/assets/fonts/ps-pixel
# 글자는 src/font-data.js 로 그린다. 폰트 파일은 만들 때만 쓰고, 라이선스 문서만 함께 올린다
/assets/fonts/ps-pixel/*.woff

# 에셋 옆의 애니메이션 정보는 게임이 읽지 않는다
/assets/sprites/**/*.json
